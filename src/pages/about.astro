---
import Base from '../layouts/Base.astro';
import ContactChannels from '../components/ContactChannels.astro';
import { SITE } from '../lib/meta';
---

<Base title="关于我" description="不睡觉变笨蛋：个人 AI 技术服务与项目解决方案提供者。AI 实战咨询、陪跑服务、AI 会员小店。">
  <header class="dark" style="padding:160px 0 90px">
    <div class="wrap" style="display:flex;gap:36px;align-items:center;flex-wrap:wrap">
      <img
        class="rv in"
        src="/images/avatar.jpg"
        alt="不睡觉变笨蛋的头像"
        style="width:132px;height:132px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,179,0,.9);box-shadow:0 0 70px rgba(255,160,0,.3)"
        width="132"
        height="132"
      />
      <div>
        <div class="eyebrow rv in">ABOUT</div>
        <h1 class="h-display rv in" style="font-size:clamp(2.2rem,5vw,3.6rem);margin-top:10px">
          不睡觉<span class="grad-text">变笨蛋</span>
        </h1>
        <p class="sub rv in" style="margin-top:10px">
          白天搞业务，晚上搞 AI，中间偶尔睡觉。
        </p>
      </div>
    </div>
  </header>

  <section class="section white">
    <div class="wrap wrap-narrow">
      <div class="eyebrow rv">我是谁</div>
      <h2 class="h-section rv" style="--d:.08s;margin:12px 0 24px">业务一线，AI 一线。</h2>
      <div class="prose rv" style="--d:.14s">
        <p>
          一句话定位：<strong>个人 AI 技术服务与项目解决方案提供者</strong>——
          不是纸上谈兵的那种。运营、电商、自媒体、投放，这些是我白天真正在打的仗；
          Codex、agent 工作流、浏览器自动化，是我晚上磨的刀。
          为了解决自己业务里的具体问题，我一个猛子扎进 AI，跑通了就把方法交付出去。
        </p>
        <p>
          折腾久了发现一件事：<strong>踩过的坑只要肯整理，就是方法论；方法论只要肯动手，就是工具。</strong>
          于是有了这个站——把我为自己做的东西，一件件摆出来给你看。
        </p>
        <p>
          「不睡觉变笨蛋」是我的抖音 ID，也是个自嘲：明知道不睡觉会变笨，还是想把喜欢的东西做出来。
          头像即本体。
        </p>
      </div>
    </div>
  </section>

  <section class="section light">
    <div class="wrap wrap-narrow">
      <div class="eyebrow rv">信条</div>
      <h2 class="h-section rv" style="--d:.08s;margin:12px 0 34px">三条底线</h2>
      <div class="rv" style="--d:.14s">
        <div class="method-row" style="background:transparent">
          <div class="method-idx">01</div>
          <div>
            <div class="method-title">方法论先于工具</div>
            <div class="method-desc">先想清楚流程，再让 AI 落地。工具会过时，想得清楚的能力不会。</div>
          </div>
        </div>
        <div class="method-row" style="background:transparent">
          <div class="method-idx">02</div>
          <div>
            <div class="method-title">结论必须附证据</div>
            <div class="method-desc">我推荐的东西都附仓库和链接，你可以自己验证——包括这条。</div>
          </div>
        </div>
        <div class="method-row" style="background:transparent">
          <div class="method-idx">03</div>
          <div>
            <div class="method-title">先跑通闭环，再谈规模</div>
            <div class="method-desc">哪怕 25 元的一单，也要是完整跑通的真实闭环，而不是 PPT 里的市场规模。</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section white" style="padding-bottom:130px">
    <div class="wrap" style="max-width:1000px">
      <div class="eyebrow rv">CONTACT & BUSINESS</div>
      <h2 class="h-section rv" style="--d:.08s;margin:12px 0 20px">找我，和我的生意</h2>
      <p class="sub rv" style="--d:.12s;margin-bottom:34px;max-width:560px">
        想合作、想咨询、想买会员，各有各的门——抖音私信最快，微信 QQ 常驻，海外走 Telegram。
      </p>
      <div class="rv" style="--d:.14s">
        <ContactChannels />
      </div>
    </div>
  </section>
</Base>
