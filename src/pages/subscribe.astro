---
import Base from '../layouts/Base.astro';
import ContactChannels from '../components/ContactChannels.astro';
import { MEMBERSHIP } from '../lib/commerce';
---

<Base title="会员中心" description="PLUS 个人技术会员 19.9 元/月：持续 AI 技术咨询、软件配置交流、专属会员社群。知识产品和工具独立购买，不捆绑。">
  <header class="dark" style="padding:160px 0 80px;text-align:center">
    <div class="wrap wrap-narrow">
      <div class="eyebrow rv in">MEMBERSHIP · 会员中心</div>
      <h1 class="h-display rv in" style="font-size:clamp(2.2rem,5.4vw,4rem);margin-top:14px">
        会员买的不是资料，<br />是一个<span class="grad-text">随时能问的人</span>。
      </h1>
      <p class="sub rv in" style="margin:20px auto 0;max-width:560px">
        知识产品单独购买，工具单独购买，会员购买的是持续咨询与社群交流。
        三者独立，互不捆绑。
      </p>
    </div>
  </header>

  <!-- ============ PLUS 会员 ============ -->
  <section class="section light">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;max-width:960px;margin-inline:auto">
        <!-- 免费（对照） -->
        <div class="card rv" style="--d:.05s">
          <div class="chip" style="margin-bottom:18px">不加入 · 也够用</div>
          <div style="font-size:2.6rem;font-weight:800;letter-spacing:-.02em">¥0</div>
          <p class="card-tagline" style="margin-top:8px">免费区永远开放。</p>
          <hr style="border:none;border-top:1px solid var(--hairline-light);margin:20px 0" />
          <ul class="prose" style="list-style:none;padding:0;font-size:14.5px">
            <li>✓ 免费知识库全部内容</li>
            <li>✓ GitHub 全部开源工具</li>
            <li>✓ 工具库免费区</li>
            <li>✓ 抖音实战更新</li>
          </ul>
          <a class="btn btn-ghost-dark" style="margin-top:24px;width:100%;justify-content:center" href="/knowledge/">去白嫖免费区</a>
        </div>

        <!-- PLUS -->
        <div class="card rv" style="--d:.12s;border:2px solid var(--accent);position:relative">
          <span class="chip chip-accent" style="position:absolute;top:-13px;right:20px;background:#fff">正式推出</span>
          <div class="chip chip-accent" style="margin-bottom:18px">PLUS 个人技术会员</div>
          <div style="font-size:2.6rem;font-weight:800;letter-spacing:-.02em">
            ¥{MEMBERSHIP.plus.price}
            <span style="font-size:14px;font-weight:600;color:var(--ink-2)">{MEMBERSHIP.plus.unit}</span>
          </div>
          <p style="font-weight:700;margin:10px 0 4px;font-size:15.5px">{MEMBERSHIP.plus.tagline}</p>
          <p class="card-tagline" style="margin-top:4px">{MEMBERSHIP.plus.positioning}</p>
          <hr style="border:none;border-top:1px solid var(--hairline-light);margin:18px 0" />
          <div style="font-size:12px;font-weight:700;letter-spacing:.14em;color:var(--ink-2);margin-bottom:8px">会员权益</div>
          <ul class="prose" style="list-style:none;padding:0;font-size:14px">
            {MEMBERSHIP.plus.rights.map((r) => <li>✓ {r}</li>)}
          </ul>
          <div style="font-size:12px;font-weight:700;letter-spacing:.14em;color:var(--ink-2);margin:16px 0 8px">规则（丑话说在前面）</div>
          <ul class="prose" style="list-style:none;padding:0;font-size:13px;color:var(--ink-2)">
            {MEMBERSHIP.plus.rules.map((r) => <li>· {r}</li>)}
          </ul>
          <a class="btn btn-primary" style="margin-top:22px;width:100%;justify-content:center" href="/services/#contact" data-mag>
            开通 PLUS · 19.9 元/月
          </a>
          <p style="font-size:12px;color:var(--ink-2);text-align:center;margin-top:10px">
            支付通道接入前，点击后通过联系通道付款开通
          </p>
        </div>

        <!-- PRO 预留 -->
        <div class="card rv btn-disabled" style="--d:.18s;position:relative">
          <span class="chip" style="position:absolute;top:-13px;right:20px;background:#fff">即将推出 · 现在不卖</span>
          <div class="chip" style="margin-bottom:18px">PRO 专业会员</div>
          <div style="font-size:2.6rem;font-weight:800;letter-spacing:-.02em">
            ¥{MEMBERSHIP.pro.price}
            <span style="font-size:14px;font-weight:600;color:var(--ink-2)">{MEMBERSHIP.pro.unit}</span>
          </div>
          <p style="font-weight:700;margin:10px 0 4px;font-size:15.5px">{MEMBERSHIP.pro.tagline}</p>
          <p class="card-tagline" style="margin-top:4px">在 PLUS 权益基础上，规划增加：</p>
          <ul class="prose" style="list-style:none;padding:0;font-size:14px;color:var(--ink-2)">
            {MEMBERSHIP.pro.futureRights.map((r) => <li>· {r}</li>)}
          </ul>
          <button class="btn btn-ghost-dark btn-disabled" style="margin-top:22px;width:100%;justify-content:center" disabled>
            未开放购买
          </button>
        </div>
      </div>

      <!-- 三者区分说明 -->
      <div class="card rv" style="--d:.1s;max-width:960px;margin:28px auto 0">
        <div class="chip chip-accent" style="margin-bottom:14px">重要区分 · 不搞捆绑</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;font-size:14px;line-height:1.9">
          <div><strong>会员咨询</strong><br /><span style="color:var(--ink-2)">日常问答与交流，合理使用内不限条数，不含实施。</span></div>
          <div><strong>产品售后</strong><br /><span style="color:var(--ink-2)">买产品/远程服务后，一个月内约定范围内免费修问题。</span></div>
          <div><strong>付费知识 / 工具</strong><br /><span style="color:var(--ink-2)">单独定价单独交付，买断归你，不随会员到期失效。</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 开通通道 ============ -->
  <section class="section white" id="contact" style="padding-top:0">
    <div class="wrap">
      <div class="section-head rv">
        <div>
          <div class="eyebrow">JOIN</div>
          <h2 class="h-section" style="margin-top:10px">开通方式</h2>
          <p class="sub" style="margin-top:12px">
            支付通道接入前：点上面「开通 PLUS」，或直接从下面任一通道联系我，
            付款后拉你进会员社群，当天生效。
          </p>
        </div>
      </div>
      <ContactChannels />
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section light" style="padding-top:0">
    <div class="wrap wrap-narrow">
      <h2 class="h-3 rv" style="margin-bottom:10px">常见问题</h2>
      <div class="prose rv" style="--d:.08s">
        <h3 style="font-size:1.05rem">会员能看所有付费资料和工具吗？</h3>
        <p>不能。这是刻意设计的：知识产品单独买、工具单独买、会员买咨询服务。谁的权益都清清楚楚，不搞交叉捆绑。</p>
        <h3 style="font-size:1.05rem">会员提问有次数限制吗？</h3>
        <p>没有机械限制。合理使用范围内持续交流，按正常服务时间回复，不承诺 24 小时即时响应。</p>
        <h3 style="font-size:1.05rem">会员到期后，之前买的知识产品和工具还在吗？</h3>
        <p>在。你独立购买的数字产品按购买时的授权规则交付，不因会员到期失效。会员到期只是咨询服务和社群 access 停止。</p>
        <h3 style="font-size:1.05rem">会员包含远程操作和项目搭建吗？</h3>
        <p>不包含。这些属于<a href="/services/">一对一项目服务</a>，按项目单独收费（88 元起）。</p>
      </div>
    </div>
  </section>
</Base>
