---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE } from '../lib/meta';
import { MEMBERSHIP } from '../lib/commerce';
import { getCollection } from 'astro:content';

const all = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order
);

const byCat = (c: string) => all.filter((w) => w.data.category === c);
const featured = all.filter((w) => w.data.featured);

const marqueeItems = [
  'VIBECODING', 'CODEX', 'AI AGENT', 'PYTHON', 'GO', 'AUTOMATION',
  'PROMPT ENGINEERING', '小红书运营', '自媒体', '电商', '方法论', '开源',
];
const stats = [
  { num: '4', label: '个开源仓库' },
  { num: '1', label: '个完整工作台' },
  { num: '2', label: '项在打磨的服务' },
  { num: '1', label: '只睡着的蛋' },
];
---

<Base>
  <!-- ================= HERO（深色） ================= -->
  <header class="hero dark">
    <div class="hero-bg"></div>
    <div class="hero-grain"></div>
    <div class="hero-mark" aria-hidden="true">蛋</div>
    <div class="hero-inner">
      <img
        class="hero-avatar rv"
        src="/images/avatar.jpg"
        alt="不睡觉变笨蛋的头像"
        width="116"
        height="116"
        style="--d:.05s"
      />
      <span class="hero-pill rv" style="--d:.15s">{SITE.latin} · 个人网站</span>
      <h1 class="h-display rv" style="--d:.25s">
        把方法论，<span class="grad-text" style="white-space:nowrap">缝成工具</span>。
      </h1>
      <p class="sub hero-sub rv" style="--d:.35s">
        你好，我是不睡觉变笨蛋，一名<span class="grad-text" style="font-weight:700">个人 AI 技术服务与项目解决方案提供者</span>。
        真实业务里跑通的方法，我做成服务卖给你、做成工具送给你，踩过的坑写成方法论。
      </p>
      <div class="hero-ctas rv" style="--d:.45s">
        <a class="btn btn-primary" href="/services/" data-mag>看看我能帮你什么</a>
        <a class="btn btn-ghost-light" href="/works/" data-mag>逛逛工具库</a>
      </div>
      <p class="hero-note rv" style="--d:.55s">说不睡觉的是我，头像里睡着的也是我。</p>
    </div>
    <div class="scroll-hint" aria-hidden="true"></div>
  </header>

  <!-- ================= 跑马灯 ================= -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() =>
        marqueeItems.map((m) => <span class="marquee-item">{m}</span>)
      )}
    </div>
  </div>

  <!-- ================= 数据（白） ================= -->
  <section class="section white">
    <div class="wrap">
      <div class="stats">
        {stats.map((s, i) => (
          <div class="rv" style={`--d:${i * 0.08}s`}>
            <div class="stat-num">{s.num}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 商业四入口 ================= -->
  <section class="section light" id="entries">
    <div class="wrap">
      <div class="section-head rv">
        <div>
          <div class="eyebrow">WHAT I OFFER</div>
          <h2 class="h-section" style="margin-top:10px">让 AI 工具真正为你所用</h2>
          <p class="sub" style="margin-top:12px">
            工具、知识、技术服务与项目陪跑，帮助你把想法变成实际成果。
          </p>
        </div>
      </div>
      <div class="grid-cards">
        {[
          { en: 'STORE', cn: 'AI 代充小店', desc: 'ChatGPT Plus / Go、Grok、Muse 会员充值：源头供应、24h 自动发货，掉订阅按天数退款。', href: SITE.shop, tag: '核心业务 · 现货热卖', accent: true, price: '¥69 起', ext: true },
          { en: 'KNOWLEDGE', cn: '知识产品', desc: '学习教程，获取实用资料。免费区随便看，付费资料单独买。', href: '/knowledge/', tag: '免费入口', accent: true, price: '¥0 起', ext: false },
          { en: 'TOOLS', cn: '工具资源', desc: '发现和使用实用工具：应用、命令行、Agent 技能，付费工具单独买。', href: '/works/', tag: '免费为主', accent: true, price: '¥0 起', ext: false },
          { en: 'MEMBERSHIP', cn: 'PLUS 会员', desc: '获得持续技术咨询和交流服务，专属会员社群。', href: '/subscribe/', tag: '正式推出', accent: false, price: '¥19.9/月', ext: false },
          { en: '1-ON-1', cn: '项目服务', desc: '一对一教学、项目陪跑、远程协助与定制实施。', href: '/services/', tag: '按项目收费', accent: false, price: '¥88 起', ext: false },
        ].map((e, i) => (
          <a
            class="card card-glare rv"
            style={`--d:${i * 0.07}s`}
            data-tilt
            href={e.href}
            target={e.ext ? '_blank' : undefined}
            rel={e.ext ? 'noopener' : undefined}
          >
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
              <span class="chip chip-accent">{e.tag}</span>
              <span class="chip">{e.price}</span>
            </div>
            <div class="eyebrow" style="margin-bottom:6px">{e.en}</div>
            <h3 class="card-title">
              {e.cn}
              {e.ext && <span aria-hidden="true"> ↗</span>}
            </h3>
            <p class="card-tagline">{e.desc}</p>
            <div class="card-foot">
              <span class="link-more">进入 <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 关注矩阵 ================= -->
  <section class="section white" id="follow">
    <div class="wrap">
      <div class="section-head rv">
        <div>
          <div class="eyebrow">FOLLOW</div>
          <h2 class="h-section" style="margin-top:10px">外面的我，天天在线</h2>
          <p class="sub" style="margin-top:12px">主阵地在抖音，实战天天更；开源的家当全在 GitHub。</p>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1.35fr 1fr;gap:22px" class="follow-grid">
        <a class="card card-glare rv" data-tilt href={SITE.douyin} target="_blank" rel="noopener" style="--d:.05s">
          <div style="display:flex;align-items:center;gap:16px;margin-bottom:14px">
            <img src="/images/avatar.jpg" alt="抖音头像" width="52" height="52" style="border-radius:50%;object-fit:cover;border:2px solid rgba(255,179,0,.6)" />
            <div>
              <div style="font-weight:700;font-size:17px">@不睡觉变笨蛋</div>
              <span class="chip chip-accent" style="margin-top:6px">主阵地 · 商务私信这里</span>
            </div>
          </div>
          <p class="card-tagline" style="margin-bottom:14px">
            vibecoding 实战、Codex 玩法、AI 变现实验、真实项目的翻车与翻盘——天天更新。
            想合作、想咨询，私信最快。
          </p>
          <div class="card-foot">
            <span class="link-more">去抖音关注 <span aria-hidden="true">↗</span></span>
          </div>
        </a>
        <a class="card card-glare rv" data-tilt href={SITE.github} target="_blank" rel="noopener" style="--d:.12s">
          <div style="margin-bottom:14px">
            <span class="chip">开源</span>
          </div>
          <h3 class="card-title">@banana2004828</h3>
          <p class="card-tagline" style="margin-bottom:14px">
            缝合怪、熊爪采集器、千问视觉工作流……开源工具都住这里，随便用，给个 star 更开心。
          </p>
          <div class="card-foot">
            <span class="link-more">GitHub 主页 <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= 工具精选（附带产品） ================= -->
  <section class="section light" id="tools">
    <div class="wrap">
      <div class="section-head rv">
        <div>
          <div class="eyebrow">TOOLS · 附带产品</div>
          <h2 class="h-section" style="margin-top:10px">顺手造的工具</h2>
          <p class="sub" style="margin-top:12px">
            实践里长出来的小东西：免费的随便拿，收费的帮你省时间。全部家当在工具库。
          </p>
        </div>
        <span class="count-badge">精选 {featured.length} / 全部 {all.length}</span>
      </div>
      <div class="grid-cards">
        {featured.map((w, i) => (
          <WorkCard work={w} delay={i * 0.07} />
        ))}
      </div>
      <div style="text-align:center;margin-top:38px" class="rv">
        <a class="btn btn-ghost-dark" href="/works/">查看完整工具库 →</a>
      </div>
    </div>
  </section>

  <!-- ================= 方法论（白） ================= -->
  <section class="section white" id="methodology">
    <div class="wrap">
      <div class="section-head rv">
        <div>
          <div class="eyebrow">PROMPTS & METHODOLOGY</div>
          <h2 class="h-section" style="margin-top:10px">提示词与方法论</h2>
          <p class="sub" style="margin-top:12px">踩坑沉淀出来的流程、模板和实战笔记，每条结论都讲证据。</p>
        </div>
        <span class="count-badge">{byCat('methodology').length} 篇</span>
      </div>
      <div>
        {byCat('methodology').map((w, i) => (
          <a class="method-row rv" style={`--d:${i * 0.06}s`} href={`/works/${w.id}/`}>
            <div class="method-idx">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <div class="method-title">{w.data.title}</div>
              <div class="method-desc">{w.data.tagline}</div>
            </div>
            <div class="card-foot">
              <span class="chip">{w.data.status === 'brewing' ? '整理中' : '免费'}</span>
              <span class="link-more">阅读 <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= PLUS 会员（深色） ================= -->
  <section class="dark" style="padding:clamp(90px,12vw,150px) 0 130px">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,6vw,72px);align-items:center" class="sub-grid">
        <div>
          <div class="eyebrow rv">MEMBERSHIP</div>
          <h2 class="h-section rv" style="--d:.08s;margin:14px 0 18px;font-size:clamp(2rem,4.6vw,3.2rem)">
            PLUS 会员：<br />把 AI 问题，交给一个<span class="grad-text">随时能问的人</span>。
          </h2>
          <ul class="sub rv" style="--d:.16s;max-width:460px;list-style:none;padding:0;font-size:15px">
            {MEMBERSHIP.plus.rights.slice(0, 5).map((r) => <li style="padding:4px 0">✓ {r}</li>)}
            <li style="padding:4px 0">✓ …和专属会员社群</li>
          </ul>
          <p class="sub rv" style="--d:.2s;font-size:13.5px;max-width:460px">
            不按条数收费、不设机械限制；不含代操作和定制开发——那些在
            <a href="/services/" style="color:var(--accent);font-weight:600">一对一服务</a>里。
          </p>
          <div class="hero-ctas rv" style="--d:.24s;margin-top:30px;justify-content:flex-start">
            <a class="btn btn-primary" href="/subscribe/" data-mag>了解 PLUS 会员</a>
            <a class="btn btn-ghost-light" href="/knowledge/">先逛免费知识区</a>
          </div>
        </div>
        <div class="rv" style="--d:.2s">
          <div class="lock-demo" style="text-align:center;padding:40px 30px">
            <div style="font-size:13px;letter-spacing:.2em;color:rgba(245,245,247,.5)">PLUS 个人技术会员</div>
            <div style="font-size:64px;font-weight:800;margin:14px 0 4px">
              ¥<span class="grad-text">{MEMBERSHIP.plus.price}</span>
            </div>
            <div style="font-size:13px;color:rgba(245,245,247,.5);margin-bottom:22px">{MEMBERSHIP.plus.unit} · 随时咨询 · 专属社群</div>
            <a class="btn btn-primary" style="width:100%;justify-content:center" href="/subscribe/">开通 / 了解权益</a>
            <div style="font-size:12px;color:rgba(245,245,247,.4);margin-top:16px">
              知识产品、工具单独购买 · 不与会员捆绑
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 820px) {
      .sub-grid {
        grid-template-columns: 1fr !important;
      }
    }
    @media (max-width: 760px) {
      .follow-grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</Base>
