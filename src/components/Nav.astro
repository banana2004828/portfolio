---
import { SITE } from '../lib/meta';
const path = Astro.url.pathname;
const active = (p: string) =>
  p === '/' ? path === '/' : path.startsWith(p);
const linkStyle = (p: string) =>
  active(p) ? 'color:#fff' : '';
const links = [
  { href: '/', full: '首页', short: '首页' },
  { href: '/knowledge/', full: '知识库', short: '知识' },
  { href: '/works/', full: '工具库', short: '工具' },
  { href: '/subscribe/', full: '会员', short: '会员' },
  { href: '/services/', full: '一对一服务', short: '服务' },
  { href: '/about/', full: '关于', short: '关于' },
];
---

<div class="nav-shell">
  <nav class="nav" aria-label="主导航">
    <a class="nav-brand" href="/">
      <img src="/images/avatar.jpg" alt="{SITE.name}头像" width="28" height="28" />
      <span>{SITE.name}</span>
    </a>
    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} style={linkStyle(l.href)} class:list={[{ 'nav-home': l.href === '/' }]}>
          <span class="nav-full">{l.full}</span>
          <span class="nav-short">{l.short}</span>
        </a>
      ))}
    </div>
    <a class="nav-cta" href={SITE.shop} target="_blank" rel="noopener" data-mag>AI 小店</a>
  </nav>
</div>

<style>
  .nav-short {
    display: none;
  }
  @media (max-width: 700px) {
    .nav-full {
      display: none;
    }
    .nav-short {
      display: inline;
    }
  }
  @media (max-width: 560px) {
    .nav-home {
      display: none !important;
    }
  }
</style>
